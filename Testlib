		table.insert(Tabs, TabObject)
		return TabObject
	end
	
	-- Rainbow + loops (you can expose _G or make a Settings table)
	local RainbowEnabled = false
	-- ... your RunService.Heartbeat loop here, but make RainbowEnabled configurable
	
