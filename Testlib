	})
	
	-- Sidebar + Page Container (same as your original)
	local Sidebar = CreateInstance("Frame", { ... }) -- copy your Sidebar code here
	local PageContainer = CreateInstance("Frame", { ... }) -- copy your PageContainer code
	
	-- Draggable
	local function MakeDraggable(frame)
		-- your existing MakeDraggable function
	end
	MakeDraggable(Main)
	MakeDraggable(ToggleBtn)
	
	ToggleBtn.MouseButton1Click:Connect(function()
		Main.Visible = not Main.Visible
	end)
	
	-- Tab system
	local Tabs = {}
	function Window:CreateTab(name)
		local TabBtn = CreateInstance("TextButton", { ... }) -- copy your AddTab logic
		local Page = CreateInstance("ScrollingFrame", { ... })
		
		-- ... rest of tab creation
		
